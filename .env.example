# --- Server ---
PORT=3000

# --- Airtable (the ONLY thing shared with coastal-elder-scheduler) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=app3N5PBKrcbX0kBu

# Table IDs within that base. Elders + Availability are confirmed from prior
# work; Campuses / Appointments / TimeOff need to be filled in — pull the
# actual table IDs from the Airtable base (or ask Claude to look them up via
# the Airtable MCP tool if it's connected in that session).
AIRTABLE_TABLE_ELDERS=tbluN8ILMjygkS1nN
AIRTABLE_TABLE_AVAILABILITY=tblpVFDPpTVrTQj4O
AIRTABLE_TABLE_CAMPUSES=tblpeLmfm04GACwGS
AIRTABLE_TABLE_APPOINTMENTS=tblIRcMiPhOIRCErY
AIRTABLE_TABLE_TIMEOFF=tblicjssPGb2wtX6O
AIRTABLE_TABLE_SUNDAY_OPTOUT=tblOgbCqocZzcKKAC
AIRTABLE_TABLE_WAC_CODES=tblcLLEySl0vDuIkC

# How many qualifying upcoming Sundays (or whichever day) getAvailableDates
# collects before stopping. Matches coastal-elder-scheduler's default.
SCHEDULING_WEEKS_AHEAD=5

# --- Auth (bearer-token PIN gate, independent of coastal-elder-scheduler's
# cookie-based gate — separate secret, separate PIN, on purpose) ---
SCHEDULER_PIN=
JWT_SECRET=

# --- Entra ID (elder/admin sign-in) ---
# Client ID and Tenant ID are not secrets (they're embedded in the mobile
# app itself) — safe to have real values here.
ENTRA_TENANT_ID=1607456c-506f-4aea-bd09-15a63ec8ad52
ENTRA_CLIENT_ID=9ae266aa-5a20-409d-8fae-153a6cedf606
ENTRA_GROUP_ID_ELDERS=5c306e93-cf56-4eea-baf0-a11c11f6000f
